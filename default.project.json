{
  "name": "blueworks",
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$path": "src/ReplicatedFirst",
      "$ignoreUnknownInstances": true
    },
    
    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",
      "$ignoreUnknownInstances": true
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService",
      "$ignoreUnknownInstances": true
    },

    "StarterGui": {
      "$path": "src/StarterGui",
      "$ignoreUnknownInstances": true
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts",
        "$ignoreUnknownInstances": true
      },
      "StarterCharacterScripts": {
        "$path": "src/StarterPlayer/StarterCharacterScripts",
        "$ignoreUnknownInstances": true
      }
    },

    "TextChatService": {
      "$className": "TextChatService",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultCommands": false,
        "CreateDefaultTextChannels": false
      },

      "General": {
        "$className": "TextChannel"
      },

      "ChatWindowConfiguration": {
        "$className": "ChatWindowConfiguration",
        "$properties": {
          "Enabled": false
        }
      },

      "ChatInputBarConfiguration": {
        "$className": "ChatInputBarConfiguration",
        "$properties": {
          "Enabled": false
        }
      },

      "BubbleChatConfiguration": {
        "$className": "BubbleChatConfiguration",
        "$properties": {
          "Enabled": true
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "PlayerScriptsUseInputActionSystem": "Disabled"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}